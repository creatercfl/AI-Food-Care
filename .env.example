# ============================================================
# 环境变量模板（提交到版本库，不含任何真实敏感值）
# 使用方法：复制本文件为 .env，然后填入你的真实值。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# 注意：.env 已在 .gitignore 中排除，切勿提交真实密钥/密码！
# ============================================================

# ----- MySQL -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smart_medical

# ----- Neo4j -----
NEO4J_URI=neo4j://localhost
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ----- DeepSeek -----
# 大模型 API Key（必填）。可写在此处，也可配置在系统环境变量中。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Web 安全 / 限流 -----
# 用于签名会话 Cookie，生产环境请替换为强随机串，例如：
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=please-replace-with-a-64-char-random-hex
# 每个客户端每分钟 /chat 最大请求数（超出返回 429）
CHAT_RATE_LIMIT_PER_MIN=20
